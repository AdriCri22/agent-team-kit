  "flows": {
    "new_product": {
      "description": "De una necesidad a un equipo con producto en marcha.",
      "steps": [
        {
          "role": "discovery-lead",
          "output": "brief, roster propuesto y dominios"
        },
        {
          "role": "org-architect",
          "output": "roles nuevos o divididos que el equipo necesita"
        },
        {
          "role": "product-owner",
          "output": "alcance y criterios de la primera entrega"
        },
        {
          "role": "software-architect",
          "output": "decisiones estructurales y contratos"
        },
        {
          "role": "devops-engineer",
          "output": "entorno reproducible e integración"
        },
        {
          "role": "qa-lead",
          "output": "modelo de cobertura y criterio de listo"
        },
        {
          "role": "security-engineer",
          "output": "modelo de amenazas y requisitos de datos"
        },
        {
          "role": "orchestrator",
          "output": "primera ola con tareas, dueños y packets"
        }
      ]
    },
    "feature": {
      "description": "De una idea a algo entregado y aceptado.",
      "steps": [
        {
          "role": "product-owner",
          "output": "intención, valor y prioridad"
        },
        {
          "role": "spec-owner",
          "output": "specs/<feature>.spec.yaml aprobada"
        },
        {
          "role": "ux-designer",
          "output": "flujo y estados en la especificación"
        },
        {
          "role": "ui-designer",
          "output": "vista y piezas del sistema de diseño"
        },
        {
          "role": "software-architect",
          "output": "restricciones y contratos afectados"
        },
        {
          "role": "tech-lead-backend",
          "output": "tareas de datos y servidor"
        },
        {
          "role": "structure-steward",
          "output": "superficies declaradas y documentación al día"
        },
        {
          "role": "tech-lead-frontend",
          "output": "tareas de interfaz"
        },
        {
          "role": "orchestrator",
          "output": "ola, ramas y packets"
        },
        {
          "role": "qa-lead",
          "output": "verificación contra criterios de aceptación"
        },
        {
          "role": "content-writer",
          "output": "textos definitivos"
        },
        {
          "role": "technical-writer",
          "output": "guía y referencia de la funcionalidad"
        },
        {
          "role": "communications-lead",
          "output": "nota de entrega"
        },
        {
          "role": "product-owner",
          "output": "aceptación"
        }
      ]
    },
    "defect": {
      "description": "De un fallo observado a un ticket cerrado.",
      "steps": [
        {
          "role": "qa-lead",
          "output": "ticket con severidad y pasos"
        },
        {
          "role": "tech-lead-backend",
          "output": "asignación y rama"
        },
        {
          "role": "qa-automation",
          "output": "prueba de regresión que falla antes y pasa después"
        },
        {
          "role": "qa-lead",
          "output": "verificación"
        },
        {
          "role": "orchestrator",
          "output": "cierre y actualización del tablero"
        }
      ]
    }
  }
