{
  "$schema_version": 2,
  "_doc": "Índice máquina del equipo. Fuente para orquestadores y herramientas. Los detalles viven en agents/roles/<rol>.yaml; si algo discrepa, manda el rol y este índice se corrige. reports_to null significa que el rol responde directamente a quien encarga el producto.",
  "actors": [
    "quien-encarga",
    "usuarios"
  ],
  "actors_doc": "Interlocutores que no son roles del equipo. Se citan en consumes como 'external:<actor>'. Añadir uno es una decisión, no un atajo.",
  "layers": [
    {
      "id": "direction",
      "name": "Dirección",
      "purpose": "orden, reparto y cierre del trabajo"
    },
    {
      "id": "governance",
      "name": "Gobierno",
      "purpose": "forma del equipo y coherencia de la estructura"
    },
    {
      "id": "discovery",
      "name": "Descubrimiento",
      "purpose": "entender la necesidad y proponer el equipo"
    },
    {
      "id": "definition",
      "name": "Definición",
      "purpose": "qué se construye, cómo se especifica y cómo se ve"
    },
    {
      "id": "engineering",
      "name": "Ingeniería",
      "purpose": "estructura, datos y construcción"
    },
    {
      "id": "assurance",
      "name": "Aseguramiento",
      "purpose": "calidad, verificación y seguridad"
    },
    {
      "id": "operations",
      "name": "Operación",
      "purpose": "entornos, despliegue y observabilidad"
    },
    {
      "id": "communication",
      "name": "Comunicación",
      "purpose": "texto, mensaje público y medición"
    }
  ],
  "roles": [
