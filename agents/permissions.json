{
  "$schema_version": 2,
  "_doc": "Matriz de acceso por rol y categoría. Fuente única para agentes y herramientas: el packet de cada tarea materializa estas categorías en rutas concretas. Niveles: none, read, write.",
  "levels": [
    "none",
    "read",
    "write"
  ],
  "categories": {
    "brief": {
      "description": "Brief del producto y convenciones.",
      "materializa": "agent/templates/product-brief.md rellenado"
    },
    "spec": {
      "description": "Especificaciones de funcionalidad. Las lee todo el mundo: de ellas salen implementación, pruebas y vista.",
      "materializa": "specs/**"
    },
    "decision": {
      "description": "Decisiones de arquitectura y de producto.",
      "materializa": "docs/decisions/**"
    },
    "product-code": {
      "description": "Implementación de producto.",
      "materializa": "las superficies que declare el mapa de dominios"
    },
    "unit-tests": {
      "description": "Pruebas junto al código.",
      "materializa": "las suites unitarias e de integración del producto"
    },
    "e2e-tests": {
      "description": "Pruebas de extremo a extremo y su infraestructura.",
      "materializa": "la suite e2e del producto"
    },
    "data-model": {
      "description": "Esquema de datos, migraciones y seeds.",
      "materializa": "el esquema y las migraciones declaradas"
    },
    "design-system": {
      "description": "Tokens, componentes y guías visuales.",
      "materializa": "el sistema de diseño del producto"
    },
    "copy": {
      "description": "Catálogo de textos y contenido editorial.",
      "materializa": "los ficheros de textos y traducciones"
    },
    "infra": {
      "description": "Pipelines, entornos, configuración de despliegue y secretos (sin valores).",
      "materializa": "la configuración de operación"
    },
    "analytics": {
      "description": "Eventos, métricas y resultados de medición.",
      "materializa": "el plan de medición y sus datos agregados"
    },
    "comms": {
      "description": "Notas de entrega, cambios publicados y comunicación externa.",
      "materializa": "el registro de comunicación del producto"
    },
    "docs": {
      "description": "Documentación para usuarios, integradores y operación.",
      "materializa": "el directorio de documentación del producto"
    },
    "system-tests": {
      "description": "Código del sistema de agentes: las herramientas de agents/tools y la suite que las verifica. No es código de producto.",
      "materializa": "agents/tools/** y tests/**"
    }
  },
